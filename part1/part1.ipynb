import json

notebook_content = {
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# HDB Resale Flat Prices ETL Pipeline (Jan 2012 – Dec 2016)\n",
    "**Senior Data Engineer Technical Assessment Implementation**\n",
    "\n",
    "This notebook implements an automated, programmatic ETL pipeline to ingest, profile, validate, clean, transform, and hash HDB resale flat transaction data for Data Science analytics."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import glob\n",
    "import re\n",
    "import hashlib\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# Configure Pandas options for scannability\n",
    "pd.set_option('display.max_columns', None)\n",
    "pd.set_option('display.float_format', lambda x: '%.2f' % x)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Raw Data Ingestion & Unification (Requirement 1 & 12)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Ingest all CSV files in raw directory\n",
    "raw_dir = './raw' if os.path.exists('./raw') else '.'\n",
    "csv_files = sorted(glob.glob(os.path.join(raw_dir, '*.csv')))\n",
    "\n",
    "raw_dfs = [pd.read_csv(f) for f in csv_files]\n",
    "raw_group = pd.concat(raw_dfs, ignore_index=True)\n",
    "\n",
    "# Standardize string attributes (Uppercase & Trim)\n",
    "string_cols = ['town', 'flat_type', 'flat_model', 'storey_range', 'street_name', 'block']\n",
    "for col in string_cols:\n",
    "    if col in raw_group.columns:\n",
    "        raw_group[col] = raw_group[col].astype(str).str.strip().str.upper()\n",
    "\n",
    "# Filter for target period: Jan 2012 to Dec 2016\n",
    "raw_group['month_dt'] = pd.to_datetime(raw_group['month'], format='%Y-%m', errors='coerce')\n",
    "target_mask = (raw_group['month_dt'] >= '2012-01-01') & (raw_group['month_dt'] <= '2016-12-31')\n",
    "target_df = raw_group[target_mask].copy()\n",
    "\n",
    "print(f\"Raw Group Total Records: {len(raw_group):,}\")\n",
    "print(f\"Target Scope (2012-01 to 2016-12) Records: {len(target_df):,}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Data Profiling & Authoritative Validation (Requirement 2 & 3)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Baseline validation against Jan 2012 authoritative dataset\n",
    "jan_2012_auth = raw_group[raw_group['month'] == '2012-01']\n",
    "auth_towns = set(jan_2012_auth['town'].unique())\n",
    "auth_flat_types = set(jan_2012_auth['flat_type'].unique())\n",
    "auth_flat_models = set(jan_2012_auth['flat_model'].unique())\n",
    "auth_storey_ranges = set(jan_2012_auth['storey_range'].unique())\n",
    "\n",
    "def validate_baseline(row):\n",
    "    reasons = []\n",
    "    if not re.match(r'^(19|20)\\d{2}-(0[1-9]|1[0-2])$', str(row['month'])):\n",
    "        reasons.append(\"INVALID_DATE_FORMAT\")\n",
    "    if row['town'] not in auth_towns:\n",
    "        reasons.append(\"TOWN_NOT_IN_BASELINE\")\n",
    "    if row['flat_type'] not in auth_flat_types:\n",
    "        reasons.append(\"FLAT_TYPE_NOT_IN_BASELINE\")\n",
    "    if row['flat_model'] not in auth_flat_models:\n",
    "        reasons.append(\"FLAT_MODEL_NOT_IN_BASELINE\")\n",
    "    if row['storey_range'] not in auth_storey_ranges:\n",
    "        reasons.append(\"STOREY_RANGE_NOT_IN_BASELINE\")\n",
    "    return \"; \".join(reasons) if reasons else \"PASSED\"\n",
    "\n",
    "target_df['validation_status'] = target_df.apply(validate_baseline, axis=1)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Remaining Lease Computation & Composite Key Deduplication (Requirement 4 & 5)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Compute 99-year remaining lease (Rounded down to Years & Months)\n",
    "def compute_remaining_lease(row):\n",
    "    trans_year, trans_month = map(int, str(row['month']).split('-'))\n",
    "    lease_commence_year = int(row['lease_commence_date'])\n",
    "    expiry_year = lease_commence_year + 99\n",
    "    \n",
    "    tot_months = (expiry_year - trans_year) * 12 - (trans_month - 1)\n",
    "    rem_years = max(0, tot_months // 12)\n",
    "    rem_months = max(0, tot_months % 12)\n",
    "    \n",
    "    return f\"{rem_years} years {rem_months} months\" if rem_months > 0 else f\"{rem_years} years\"\n",
    "\n",
    "target_df['computed_remaining_lease'] = target_df.apply(compute_remaining_lease, axis=1)\n",
    "\n",
    "# Deduplicate on composite key retaining maximum resale price\n",
    "composite_cols = ['month', 'town', 'flat_type', 'block', 'street_name', 'storey_range', 'floor_area_sqm', 'flat_model', 'lease_commence_date']\n",
    "sorted_df = target_df.sort_values(by=composite_cols + ['resale_price'], ascending=[True]*len(composite_cols) + [False])\n",
    "\n",
    "dup_mask = sorted_df.duplicated(subset=composite_cols, keep='first')\n",
    "quarantined_duplicates = sorted_df[dup_mask].copy()\n",
    "quarantined_duplicates['quarantine_reason'] = \"DUPLICATE_LOWER_PRICE\"\n",
    "\n",
    "deduped_df = sorted_df[~dup_mask].copy()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Anomaly Detection & Output Group Generation (Requirements 6, 7 & 12)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Price per SQM IQR outlier detection\n",
    "deduped_df['psm'] = deduped_df['resale_price'] / deduped_df['floor_area_sqm']\n",
    "\n",
    "def flag_outliers(grp):\n",
    "    q1 = grp['psm'].quantile(0.25)\n",
    "    q3 = grp['psm'].quantile(0.75)\n",
    "    iqr = q3 - q1\n",
    "    grp['is_anomaly'] = (grp['psm'] < (q1 - 2.5 * iqr)) | (grp['psm'] > (q3 + 2.5 * iqr))\n",
    "    return grp\n",
    "\n",
    "deduped_df = deduped_df.groupby(['town', 'flat_type'], group_keys=False).apply(flag_outliers)\n",
    "\n",
    "# Isolate Cleaned vs Quarantined\n",
    "val_fail = deduped_df['validation_status'] != 'PASSED'\n",
    "anom_fail = deduped_df['is_anomaly'] == True\n",
    "\n",
    "quarantined_val = deduped_df[val_fail].copy()\n",
    "quarantined_val['quarantine_reason'] = quarantined_val['validation_status']\n",
    "\n",
    "quarantined_anom = deduped_df[anom_fail & (~val_fail)].copy()\n",
    "quarantined_anom['quarantine_reason'] = \"PRICE_PER_SQM_ANOMALY\"\n",
    "\n",
    "quarantined_group = pd.concat([quarantined_duplicates, quarantined_val, quarantined_anom], ignore_index=True)\n",
    "cleaned_group = deduped_df[(~val_fail) & (~anom_fail)].copy()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Resale Identifier Transformation & Hashing (Requirements 9, 10 & 12)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Derived Resale Identifier\n",
    "group_avg = cleaned_group.groupby(['month', 'town', 'flat_type'])['resale_price'].mean().reset_index()\n",
    "group_avg['avg_price_2digits'] = group_avg['resale_price'].apply(lambda x: f\"{int(round(x)):02d}\"[:2])\n",
    "\n",
    "transformed_group = cleaned_group.merge(group_avg[['month', 'town', 'flat_type', 'avg_price_2digits']], on=['month', 'town', 'flat_type'], how='left')\n",
    "\n",
    "def build_resale_identifier(row):\n",
    "    c1 = 'S'\n",
    "    blk_digits = re.sub(r'\\D', '', str(row['block']))\n",
    "    blk_3digits = blk_digits[:3].zfill(3) if blk_digits else '000'\n",
    "    avg_2digits = str(row['avg_price_2digits'])\n",
    "    month_2digits = str(row['month']).split('-')[1]\n",
    "    town_char = str(row['town']).strip()[0].upper()\n",
    "    return f\"{c1}{blk_3digits}{avg_2digits}{month_2digits}{town_char}\"\n",
    "\n",
    "transformed_group['Resale Identifier'] = transformed_group.apply(build_resale_identifier, axis=1)\n",
    "\n",
    "# Hashed Group\n",
    "hashed_group = transformed_group.copy()\n",
    "hashed_group['Hashed Identifier'] = hashed_group['Resale Identifier'].apply(lambda x: hashlib.sha256(x.encode('utf-8')).hexdigest())\n",
    "\n",
    "print(\"ETL Pipeline execution completed successfully.\")"
   ]
  }
 ],
 "metadata": {
  "language_info": {
   "name": "python"
  }
 },
